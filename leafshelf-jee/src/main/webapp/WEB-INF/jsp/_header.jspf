<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>${pageTitle != null ? pageTitle : 'LeafShelf'} — LeafShelf</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..700&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        :root { --ink:#1c1a17; --paper:#f4ede0; --paper-warm:#ebe2d0; --forest:#1f3f32; --forest-dark:#162d24;
                --forest-mid:#356851; --forest-light:#aec5b6; --gold:#c8a558; --gold-dark:#b08d3f; --rust:#a8542b; }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: 'DM Sans', system-ui, sans-serif; background: var(--paper); color: var(--ink);
               line-height: 1.5; min-height: 100vh; display: flex; flex-direction: column;
               background-image: radial-gradient(ellipse at top left, rgba(31,63,50,0.10), transparent 55%),
                                 radial-gradient(ellipse at bottom right, rgba(200,165,88,0.18), transparent 50%); }
        h1, h2, h3 { font-family: 'Fraunces', Georgia, serif; color: var(--forest-dark); margin: 0 0 0.5rem; font-weight: 400; }
        h1 { font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: 1.05; }
        h2 { font-size: clamp(1.5rem, 3vw, 2.25rem); }
        a { color: var(--forest); text-decoration: none; }
        a:hover { color: var(--forest-dark); }
        .tag { letter-spacing: 0.22em; text-transform: uppercase; font-size: 0.7rem; color: var(--gold-dark); font-weight: 500; }
        header.nav { position: sticky; top:0; z-index: 30; backdrop-filter: blur(10px);
                     background: rgba(244,237,224,0.85); border-bottom: 1px solid rgba(31,63,50,0.1); }
        header.nav .inner { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem;
                            display: flex; align-items: center; justify-content: space-between; height: 64px; gap: 1rem; }
        .brand { font-family: 'Fraunces', serif; font-size: 1.3rem; color: var(--forest-dark);
                 display:flex; align-items:center; gap: 0.5rem; }
        .brand .gold { color: var(--gold-dark); }
        nav.links { display: flex; gap: 1.75rem; align-items: center; flex-wrap: wrap; }
        nav.links a { font-size: 0.9rem; color: var(--forest-mid); }
        nav.links a.active { color: var(--forest-dark); font-weight: 500; }
        nav.links a.gold { color: var(--gold-dark); }
        .container { max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem; flex: 1; width: 100%; }
        .btn { display: inline-block; padding: 0.75rem 1.5rem; border-radius: 999px; font-size: 0.85rem;
               cursor: pointer; border: none; font-family: inherit; text-decoration: none; line-height: 1; }
        .btn-primary { background: var(--forest-dark); color: var(--paper); }
        .btn-ghost { background: transparent; color: var(--forest-dark); border: 1px solid var(--forest-light); }
        .btn-gold { background: var(--gold); color: var(--forest-dark); }
        .btn:hover { opacity: 0.92; }
        .btn:disabled { opacity: 0.5; cursor: not-allowed; }
        footer { padding: 2.5rem 1.5rem; border-top: 1px solid rgba(31,63,50,0.1);
                 color: var(--forest-mid); text-align:center; font-size: 0.85rem; }
        .chip { display: inline-flex; padding: 0.3rem 0.8rem; border-radius: 999px; font-size: 0.7rem;
                text-transform: uppercase; letter-spacing: 0.15em; background: rgba(31,63,50,0.06);
                color: var(--forest-mid); border: 1px solid rgba(31,63,50,0.1);
                margin-right: 0.4rem; margin-bottom: 0.4rem; text-decoration: none; }
        .chip.active { background: var(--forest-dark); color: var(--paper); }
        .chip.gold { background: rgba(200,165,88,0.15); color: var(--gold-dark); border-color: rgba(200,165,88,0.3); }
        input[type=text], input[type=search], input[type=email], input[type=password] {
            width: 100%; padding: 0.75rem 1rem; border-radius: 8px; border: 1px solid var(--forest-light);
            background: var(--paper); font-family: inherit; font-size: 0.95rem; }
        input:focus { outline: 2px solid var(--forest-mid); outline-offset: -1px; }
        label { display: block; font-size: 0.85rem; color: var(--forest-mid); margin-bottom: 0.4rem; font-weight: 500; }
        .notice { padding: 0.85rem 1rem; border-radius: 8px; margin: 1rem 0; font-size: 0.9rem; }
        .notice.success { background: rgba(31,63,50,0.08); color: var(--forest-dark); border: 1px solid var(--forest-light); }
        .notice.error { background: rgba(168,84,43,0.1); color: var(--rust); border: 1px solid rgba(168,84,43,0.3); }
        .card { background: rgba(235,226,208,0.5); backdrop-filter: blur(4px);
                border: 1px solid rgba(31,63,50,0.08); border-radius: 16px; padding: 1.75rem; }
        .grid-books { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 1.5rem 1rem; }
        .book-card { display: block; color: inherit; text-decoration: none; }
        .book-cover { aspect-ratio: 2/3; background: linear-gradient(135deg, #274f3e, #1f3f32);
                      border-radius: 4px; overflow: hidden; position: relative;
                      box-shadow: 0 12px 32px -16px rgba(28,26,23,0.35), 0 2px 6px -2px rgba(28,26,23,0.12);
                      transition: transform 0.2s; }
        .book-card:hover .book-cover { transform: translateY(-3px); }
        .book-cover img { width: 100%; height: 100%; object-fit: cover; }
        .book-cover .fallback { padding: 1rem; color: var(--paper); font-family: 'Fraunces', serif;
                                font-size: 0.85rem; display: flex; flex-direction: column;
                                height: 100%; justify-content: space-between; }
        .book-cover .fallback small { font-family: 'DM Sans', sans-serif; font-size: 0.65rem;
                                       letter-spacing: 0.2em; opacity: 0.7; text-transform: uppercase; }
        .book-cover .dot { position: absolute; top: 8px; right: 8px; width: 10px; height: 10px;
                           border-radius: 50%; box-shadow: 0 0 0 2px var(--paper); }
        .book-cover .dot.available { background: var(--gold); }
        .book-cover .dot.taken { background: var(--rust); }
        .book-meta { margin-top: 0.85rem; }
        .book-meta .small { font-size: 0.65rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--forest-mid); }
        .book-meta h3 { font-size: 1rem; margin: 0.25rem 0 0.15rem; line-height: 1.25; }
        .book-meta .author { font-style: italic; font-size: 0.8rem; color: var(--forest-mid); }
        .book-meta .extra { font-size: 0.75rem; color: var(--forest-mid); margin-top: 0.35rem; }
        @media (max-width: 640px) {
            header.nav .inner { height: auto; padding: 0.75rem 1rem; flex-wrap: wrap; }
            nav.links { gap: 1rem; }
            nav.links a { font-size: 0.85rem; }
        }
    </style>
</head>
<body>
<header class="nav">
    <div class="inner">
        <a class="brand" href="<c:url value='/classic' />">
            🌿 Leaf<span class="gold">Shelf</span>
        </a>
        <nav class="links">
            <a class="${active == 'home' ? 'active' : ''}" href="<c:url value='/classic' />">Home</a>
            <a class="${active == 'books' ? 'active' : ''}" href="<c:url value='/classic/books' />">Catalog</a>
            <c:choose>
                <c:when test="${not empty currentUser}">
                    <a class="${active == 'library' ? 'active' : ''}" href="<c:url value='/classic/library' />">My Library</a>
                    <a href="<c:url value='/classic/logout' />">Sign out (<c:out value='${currentUser.name}'/>)</a>
                </c:when>
                <c:otherwise>
                    <a class="${active == 'login' ? 'active' : ''}" href="<c:url value='/classic/login' />">Sign in</a>
                </c:otherwise>
            </c:choose>
            <a class="gold" href="<c:url value='/' />">Modern UI →</a>
        </nav>
    </div>
</header>
<main class="container">
